    },
    {
      "shape_id": 3,
      "kind": "text",
      "text": "The \"noodle\" theory was overturned by two giants of neuroscience who shared the Nobel Prize in 1906.",
      "alt_text": "Text 1",
      "manim_bbox": [
        -6.446643235520834,
        2.2010420575694445,
        6.446643235520834,
        2.5048614365104167
      ]
    },
    {
      "shape_id": 4,
      "kind": "picture",
      "text": null,
