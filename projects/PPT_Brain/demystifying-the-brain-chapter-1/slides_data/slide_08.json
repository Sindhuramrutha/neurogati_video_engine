        -0.11863419664930497,
        1.9874997259201388
      ]
    },
    {
      "shape_id": 5,
      "kind": "text",
      "text": "Camillo Golgi",
      "alt_text": "Text 2",
      "manim_bbox": [
        -6.446643235520834,
        -2.4099533015104173,
        -4.0732632784375,
        -2.113309969895833
      ]
    },
    {
      "shape_id": 6,
      "kind": "text",
      "text": "Developed a staining technique that \"colored\" individual cells, making them stand out against the background.",
      "alt_text": "Text 3",
      "manim_bbox": [
        -6.446643235520834,
        -3.131481432552083,
        -0.11863419664930497,
        -2.5238426746701395
      ]
    },
    {
      "shape_id": 7,
      "kind": "picture",
      "text": null,
