        6.446643235520834,
        1.9874997259201388
      ]
    },
    {
      "shape_id": 8,
      "kind": "text",
      "text": "Ramon y Cajal",
      "alt_text": "Text 4",
      "manim_bbox": [
        0.11863419664930497,
        -2.4099533015104173,
        2.4920141537326375,
        -2.113309969895833
      ]
    },
    {
      "shape_id": 9,
      "kind": "text",
      "text": "Used Golgi's stain to prove the brain is made of discrete cells (neurons) that contact each other via \"wires,\" establishing the Neuron Doctrine.",
      "alt_text": "Text 5",
      "manim_bbox": [
        0.11863419664930497,
        -3.131481432552083,
        6.446643235520834,
        -2.5238426746701395
      ]
    },
    {
      "shape_id": 10,
      "kind": "text",
      "text": "Later, Ross Harrison confirmed this by observing embryonic neurons extending tentacles to make contact, proving gaps existed between them.",
      "alt_text": "Text 6",
      "manim_bbox": [
        -6.446643235520834,
        -3.648842171041667,
        6.446643235520834,
        -3.3450227921006945
      ]
    }
  ],
