    },
    {
      "shape_id": 8,
      "kind": "text",
      "text": "Patients are often unaware of their deficit, unlike Broca's patients who painfully recognize their struggle.",
      "alt_text": "Text 3",
      "manim_bbox": [
        -6.118981142847223,
        -1.714236388107639,
