    },
    {
      "shape_id": 4,
      "kind": "text",
      "text": "Carl Wernicke identified a contrary disorder where speech remains fluent but lacks meaning—often described as \"word salad.\"",
      "alt_text": "Text 1",
      "manim_bbox": [
        -6.339467189756944,
